---
const { title = 'Barilochense.com' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Cultura y Turismo en Bariloche" />
    <link rel="icon" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <svg class="svg-defs" aria-hidden="true">
      <defs>
        <symbol id="search" viewBox="0 0 24 24"><circle cx="10" cy="10" r="7"></circle><line x1="21" y1="21" x2="15" y2="15"></line></symbol>
        <symbol id="user" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"></circle><path d="M4 20c0-4 4-6 8-6s8 2 8 6"></path></symbol>
        <symbol id="menu" viewBox="0 0 24 24"><line x1="4" y1="6" x2="20" y2="6"></line><line x1="4" y1="12" x2="20" y2="12"></line><line x1="4" y1="18" x2="20" y2="18"></line></symbol>
        <symbol id="close" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"></path></symbol>
        <symbol id="arrow" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"></path></symbol>
        <symbol id="music" viewBox="0 0 24 24"><circle cx="6" cy="17" r="3"></circle><circle cx="17" cy="15" r="3"></circle><path d="M9 17V4l11-2v13"></path></symbol>
        <symbol id="museum" viewBox="0 0 24 24"><path d="M3 21h18M5 21V10m4.5 11V10m5 11V10M19 21V10M3 10l9-6 9 6z"></path></symbol>
        <symbol id="mountain" viewBox="0 0 24 24"><path d="M3 20l6-14 4 8 3-4 5 10z"></path></symbol>
        <symbol id="users" viewBox="0 0 24 24"><circle cx="9" cy="7" r="3"></circle><path d="M3 20c0-3 2.5-5 6-5s6 2 6 5"></path><circle cx="17" cy="8" r="2.5"></circle></symbol>
        <symbol id="radio" viewBox="0 0 24 24"><rect x="3" y="9" width="18" height="12" rx="2"></rect><circle cx="14" cy="15" r="3"></circle><path d="M7 15h.01M7 18h.01M10 9l9-5"></path></symbol>
      </defs>
    </svg>
    <slot />
  </body>
</html>

<style is:global>
  :root{--cultura:#6a3fa0;--celeste:#75aadb;--celeste-suave:#eef5fb;--azul:#085c8f;--azul-oscuro:#063f63;--footer:#052945;--dorado:#fdc130;--violeta:#085c8f;--teal:#00695c;--rojo:#c12a2a;--naranja:#e65100;--text:#0a0a0a;--secondary:rgba(0,0,0,.65);--muted:rgba(0,0,0,.45);--border:#ebf2f6;--strong:#cedee9;--page:#fafbfd;--card:#fff}
  *{box-sizing:border-box}html{background:#e7ecf1}body{margin:0;background:var(--page);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;line-height:1.5;-webkit-font-smoothing:antialiased}.svg-defs{position:absolute;width:0;height:0;overflow:hidden}.icon{width:1em;height:1em;display:inline-block;vertical-align:-.125em;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}a{color:inherit}
  .frame{max-width:1600px;min-height:100vh;margin:0 auto;background:var(--card);box-shadow:0 0 20px rgba(0,0,0,.05);position:relative}
  .site-header{display:flex;align-items:center;justify-content:space-between;padding:12px 14px;border-bottom:1px solid var(--dorado);background:var(--card);position:sticky;top:0;z-index:50}.header-left,.header-right,.header-brand,.site-icons{display:flex;align-items:center}.header-brand{gap:8px}.logo{height:28px;width:auto}.header-brand-col{display:none}.header-brand-text,.header-claim{display:none}.site-nav,.site-utility,.divider-v{display:none}.site-icons{gap:16px;color:var(--secondary);font-size:22px}.menu-btn{display:inline-flex;align-items:center;justify-content:center;padding:0;border:0;background:none;color:inherit;cursor:pointer;line-height:0}.mobile-utility-bar{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:8px;padding:8px 14px;border-bottom:1px solid var(--border);font-size:12px}.utility-link{font-weight:600;color:var(--azul);text-decoration:none}.mobile-utility-bar .utility-link:first-child{justify-self:start}.utility-date{text-align:center;color:var(--secondary)}.utility-radios{justify-self:end;display:inline-flex;align-items:center;gap:5px}
  .hero-layout{display:flex;flex-direction:column;gap:14px;padding:14px}.hero-col{flex:1}.hero-slide .img{position:relative;display:block;width:100%;height:auto;aspect-ratio:4/3;overflow:hidden;border-radius:8px;background:var(--border)}.hero-slide-item{position:absolute;inset:0;opacity:0;pointer-events:none;transition:opacity .4s}.hero-slide-item.active{opacity:1;pointer-events:auto;z-index:1}.hero-photo{display:block;width:100%;height:100%;object-fit:cover}.hero-badge{position:absolute;bottom:12px;left:12px;display:inline-flex;align-items:center;gap:4px;padding:4px 8px;border-radius:4px;background:#fff;box-shadow:0 2px 4px rgba(0,0,0,.1);font-size:11px;font-weight:700;text-transform:uppercase}.hero-dots{position:absolute;right:12px;bottom:12px;z-index:2;display:flex;gap:6px}.hero-dot{width:7px;height:7px;padding:0;border:0;border-radius:50%;background:rgba(255,255,255,.55);cursor:pointer}.hero-dot.active{background:#fff;transform:scale(1.2)}.hero-caption{padding:8px 0 0}.hero-caption h1{margin:0 0 4px;font-size:16px;font-weight:500;line-height:1.3}.hero-caption p{margin:0;color:var(--secondary);font-size:12px}
  .explore-col{display:flex;flex-direction:column;gap:8px}.explore-card{display:flex;align-items:center;gap:10px;min-height:52px;padding:0 12px 0 0;overflow:hidden;border-left:3px solid var(--azul);border-radius:6px;background:var(--celeste-suave);text-decoration:none;transition:transform .15s,background .15s}.explore-card:hover{background:#e2ecf6;transform:translateX(2px)}.ex-thumb{width:40px;height:52px;object-fit:cover;flex-shrink:0}.ex-txt{min-width:0}.ex-head{display:flex;align-items:center;justify-content:space-between;gap:10px}.ex-title{margin:0;font-size:14px;font-weight:700}.ex-desc{display:none}.ex-arrow{display:none}
  .quick-bands{display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:10px 14px;border-top:1px solid var(--dorado);border-bottom:1px solid var(--dorado)}.qband{display:flex;align-items:center;gap:8px;min-width:0;padding:10px 12px;border-radius:10px;text-decoration:none}.qband-icon{font-size:18px;flex-shrink:0}.qband-text{min-width:0}.qband-label{display:block;font-size:13px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.qband-value{display:block;font-size:10.5px;line-height:1.25;opacity:.85}.qband-radios{display:none;background:#f3eefa;color:#4b2a82}.qband-diarios{background:#f1f5f9;color:#33415c}.qband-farmacia{background:#f0fdf4;color:#173404}.qband-clima{background:#fef9c3;color:#713f12}.qband-dolar{background:#eff6ff;color:#042c53}
  .content-section{padding:20px 14px}.section-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}.section-label{font-size:13px;font-weight:700;letter-spacing:.5px;text-transform:uppercase;color:var(--secondary)}.section-description{margin:3px 0 14px;color:var(--secondary);font-size:13px}.news-grid{display:grid;grid-template-columns:1fr;gap:10px}.news-card{display:flex;align-items:center;gap:12px;padding:8px 0;border-bottom:1px solid var(--border);text-decoration:none}.news-card:last-child{border-bottom:0}.news-thumb{width:64px;height:54px;flex-shrink:0;object-fit:cover;border-radius:6px;background:var(--celeste-suave)}.news-body{min-width:0}.eyebrow-tag{display:block;margin-bottom:2px;color:var(--teal);font-size:10px;font-weight:700;letter-spacing:.5px;text-transform:uppercase}.card-title{margin:0;font-size:14px;font-weight:600;line-height:1.35}.card-summary{margin:2px 0 0;color:var(--secondary);font-size:11px;line-height:1.3}.pager{display:flex;align-items:center;justify-content:center;gap:12px;margin-top:12px}.pager button{border:1px solid var(--strong);border-radius:999px;background:#fff;color:var(--azul);cursor:pointer;padding:4px 10px}.pager button:disabled{opacity:.35;cursor:not-allowed}.api-note{margin:10px 0 0;color:var(--muted);font-size:11px}
  .ad-slot{display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:90px;margin:0 14px 20px;border:1px dashed var(--strong);border-radius:4px;background:var(--celeste-suave);color:var(--muted)}.ad-label{font-size:9px;letter-spacing:.5px;text-transform:uppercase}.ad-size{font-size:11px;font-weight:700}
  .site-footer{display:grid;grid-template-columns:1fr 1fr;gap:24px 16px;padding:28px 14px;border-top:1px solid var(--dorado);background:#fff}.site-footer>div:first-child{grid-column:1/-1}.logo-footer{display:block;width:auto;height:72px;margin-bottom:14px}.social{display:flex;gap:16px;color:var(--azul);font-size:24px}.footer-col-title{margin:0 0 16px;color:var(--muted);font-size:12px;font-weight:700;letter-spacing:1px;text-transform:uppercase}.footer-links{display:flex;flex-direction:column;gap:12px;color:var(--secondary);font-size:14px}.footer-links a{text-decoration:none}.footer-links a:hover{color:var(--azul)}.footer-bottom{display:flex;align-items:center;justify-content:center;padding:20px 14px;border-top:1px solid var(--border);background:var(--page);color:var(--secondary);font-size:12px;text-align:center}.footer-bottom p{margin:0}
  .sticky-ad{position:fixed;right:0;bottom:0;left:0;z-index:40;display:flex;justify-content:center;padding:8px;border-top:1px solid var(--border);background:rgba(255,255,255,.95);backdrop-filter:blur(4px)}.sticky-ad .ad-slot{width:min(320px,100%);min-height:42px;margin:0;border:0;background:transparent}
  .dr-overlay{position:fixed;inset:0;z-index:998;background:rgba(10,30,50,.5);opacity:0;visibility:hidden;transition:.2s}.drawer{position:fixed;top:0;right:0;z-index:999;width:min(560px,100%);max-height:100%;overflow:auto;padding:18px 18px 22px;border-bottom:3px solid var(--dorado);background:#fff;box-shadow:0 18px 48px rgba(0,0,0,.25);transform:translateY(-12px);opacity:0;visibility:hidden;transition:.22s}.menu-open .dr-overlay{opacity:1;visibility:visible}.drawer.open{transform:none;opacity:1;visibility:visible}.menu-open{overflow:hidden}.dr-close{position:absolute;top:8px;right:8px;width:40px;height:40px;border:0;background:none;cursor:pointer}.dr-inicio{display:flex;justify-content:center;align-items:center;gap:8px;padding:6px 40px 16px;color:var(--azul);font-size:17px;font-weight:700;text-decoration:none}.dr-inicio img{width:26px;height:26px}.dr-list{margin:0;padding:0;list-style:none}.dr-list>li{border-top:1px solid #d9e0e7}.dr-row{display:flex;align-items:center;gap:14px;width:100%;padding:16px 8px;border:0;background:none;font:inherit;font-size:16px;font-weight:500;text-align:left;cursor:pointer}.dr-row:hover{background:var(--celeste-suave)}.dr-row .ic{width:24px;height:24px;color:var(--c,#0a0a0a)}.dr-row .arr{width:14px;height:14px;margin-left:auto;transition:transform .2s}.dr-row[aria-expanded=true] .arr{transform:rotate(180deg)}.is-agenda{--c:var(--azul)}.is-cultura{--c:var(--cultura)}.is-turismo{--c:var(--teal)}.is-gourmet{--c:var(--rojo)}.is-comunidad{--c:var(--naranja)}.dr-sub{display:grid;grid-template-columns:repeat(2,1fr);margin:0;padding:0 0 8px;list-style:none}.dr-sub[hidden]{display:none}.dr-sub li{border-top:1px solid #e6ebf0}.dr-sub a{display:block;padding:12px 8px;color:#33414e;font-size:14px;text-decoration:none}.dr-foot{display:flex;flex-direction:column;align-items:flex-end;gap:8px;margin-top:18px}.dr-foot .lbl{font-size:13px;font-weight:700}.dr-social{display:flex;gap:12px}.dr-social a{color:#0a0a0a;text-decoration:none}.dr-social svg{width:26px;height:26px}
  @media(min-width:768px){body{background:var(--page)}.site-header{display:grid;grid-template-columns:2fr 1fr;gap:20px;padding:16px 28px}.header-left{position:relative}.logo{height:34px}.header-brand-text{font-size:21px}.site-nav{display:flex;align-items:center;justify-content:space-between;flex:1;margin-left:96px;font-size:15px;font-weight:700}.site-nav a,.site-nav span{padding-bottom:4px;border-bottom:2px solid transparent;text-decoration:none}.site-nav .active{border-bottom-color:currentColor}.nav-agenda{color:var(--violeta)}.nav-cultura{color:var(--cultura)}.nav-turismo{color:var(--teal)}.nav-gourmet{color:var(--rojo)}.nav-comunidad{color:var(--naranja)}.divider-v{display:block;position:absolute;right:-21px;top:50%;width:1px;height:24px;background:var(--dorado);transform:translateY(-50%)}.header-right{justify-content:space-between;gap:16px;padding-left:20px}.site-utility{display:flex;align-items:center;gap:20px;color:var(--secondary);font-size:13px}.site-utility .utility-link{font-weight:400;color:var(--secondary)}.mobile-utility-bar{display:none}.hero-layout{display:grid;grid-template-columns:2fr 1fr;gap:20px;padding:20px 28px 16px;container-type:inline-size;align-items:start}.hero-slide .img{aspect-ratio:4/3}.explore-col{height:calc((100cqw - 20px)/2)}.explore-card{flex:1;min-height:0;padding:8px 14px 8px 8px}.ex-thumb{width:auto;height:100%;aspect-ratio:4/3}.ex-title{font-size:clamp(16px,1.15vw,20px)}.ex-desc{display:block;margin:3px 0 0;color:#5a6b7a;font-size:clamp(12.5px,.9vw,15px);line-height:1.35}.ex-arrow{display:inline-flex;align-items:center;gap:6px;margin-left:auto;color:inherit;font-size:13px;font-weight:700;white-space:nowrap}.ex-arrow em{font-style:normal}.ex-arrow svg{width:20px;height:20px}.quick-bands{grid-template-columns:repeat(5,1fr);padding:10px 28px}.qband{padding:16px 24px;gap:10px}.qband-radios{display:flex}.qband-label{font-size:15px}.qband-value{font-size:12px}.content-section{padding:28px}.news-grid{grid-template-columns:repeat(4,1fr);gap:14px}.news-card{display:block;padding:0;border:1px solid var(--border);border-radius:8px;overflow:hidden}.news-thumb{width:100%;height:130px;border-radius:0}.news-body{padding:12px}.card-title{font-size:14px}.ad-slot{min-height:120px;margin:0 auto 24px;max-width:970px}.site-footer{display:flex;justify-content:space-between;padding:48px 28px}.site-footer>div{flex:1}.site-footer>div:first-child{flex:2;padding-right:48px}.logo-footer{height:84px}.footer-bottom{justify-content:space-between;padding:20px 28px;text-align:left}.sticky-ad{display:none}.drawer{padding:20px 28px 22px}}
</style>
